cmd-fakeplayercount_add-desc = Adds to the fake player count padding shown in the launcher/server list.
cmd-fakeplayercount_add-help = Usage: fakeplayercount_add <amount>

cmd-fakeplayercount_subtract-desc = Subtracts from the fake player count padding shown in the launcher/server list. Cannot go below zero.
cmd-fakeplayercount_subtract-help = Usage: fakeplayercount_subtract <amount>

cmd-fakeplayercount_reset-desc = Resets the fake player count padding back to zero.
cmd-fakeplayercount_reset-help = Usage: fakeplayercount_reset

fakeplayercount-command-set = The fake player count padding is now { $count }.
fakeplayercount-command-denied = You are not authorized to use this command.
