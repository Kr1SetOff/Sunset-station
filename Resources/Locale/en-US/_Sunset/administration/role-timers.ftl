# Role timers toggle (_Sunset)

cmd-toggleroletimers-desc = Enables or disables playtime requirements for roles.
cmd-toggleroletimers-help = toggleroletimers [true/false]
cmd-toggleroletimers-enabled = Role timers ENABLED: roles require playtime again.
cmd-toggleroletimers-disabled = Role timers DISABLED: all roles are open with no playtime requirements.

administration-ui-round-tab-toggle-role-timers = Toggle role timers
