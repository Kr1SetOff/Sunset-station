# Сущности битраннинга (_Sunset): машины, диски, действия

# Машины
ent-QuantumServer = квантовый сервер
    .desc = Высокоплотное симуляционное оборудование для виртуальных доменов.
ent-QuantumConsole = квантовая консоль
    .desc = Консоль для выбора и управления доменами битраннинга.
ent-Netpod = нетпод
    .desc = Капсула нейронной связи для сессий аватаров битраннинга.
ent-Byteforge = байтфордж
    .desc = Квантовый процессор, перекомпилирующий доставленные ящики с кэшем в физические награды.
ent-CrateBitrunSecureReward = ящик наград битраннинга
    .desc = Ящик с физическими наградами, перекомпилированными из доставленного кэша битраннинга.
ent-QuantumServerMachineCircuitboard = плата квантового сервера
    .desc = Печатная плата машины для квантового сервера.
ent-QuantumConsoleCircuitboard = плата квантовой консоли
    .desc = Печатная плата компьютера для квантовой консоли.
ent-NetpodMachineCircuitboard = плата нетпода
    .desc = Печатная плата машины для нетпода.
ent-ByteforgeMachineCircuitboard = плата байтфорджа
    .desc = Печатная плата машины для байтфорджа.

# Грузы
ent-EncryptedCacheNode = зашифрованный кэш
    .desc = Защищённый целевой кэш с зашифрованными данными верификации битраннинга.
ent-BitrunningObjectiveCacheStructure = кэш битраннинга
    .desc = Ящик с зашифрованным грузом. Дотащите его до маркера доставки, чтобы он исчез отсюда и материализовался в виде ящика наград у байтфорджа.

# Диски
ent-BaseBitrunningDisk = диск битраннинга
    .desc = Специализированный диск данных для систем снабжения битраннинга.
ent-BitrunningExtensionPlayerAppearanceDisk = расширение битраннинга: внешность
    .desc = Позволяет вашему аватару загрузить вашу собственную внешность вместо стандартной человеческой оболочки.
ent-BitrunningGearSimpleDisk = снаряжение битраннинга: простое
    .desc = Используйте в руке, чтобы выбрать одноразовый комплект снаряжения.
ent-BitrunningGearComplexDisk = снаряжение битраннинга: сложное
    .desc = { ent-BitrunningGearSimpleDisk.desc }
ent-BitrunningGearAdvancedDisk = снаряжение битраннинга: продвинутое
    .desc = { ent-BitrunningGearSimpleDisk.desc }
ent-BitrunningProgramBasicDisk = программа битраннинга: базовая
    .desc = Используйте в руке, чтобы выбрать одно программное действие.
ent-BitrunningProgramComplexDisk = программа битраннинга: сложная
    .desc = { ent-BitrunningProgramBasicDisk.desc }
ent-BitrunningProgramEliteDisk = программа битраннинга: элитная
    .desc = { ent-BitrunningProgramBasicDisk.desc }
ent-BitrunningGimmickSportsDisk = гиммик битраннинга: спорт
    .desc = В будущем обновлении будет выдавать выбираемый спортивный набор снаряжения.
ent-BitrunningGimmickDungeonCrawlingDisk = гиммик битраннинга: подземелья
    .desc = В будущем обновлении будет выдавать выбираемый набор снаряжения для подземелий.
ent-BitrunningGearPKAModsDisk = снаряжение битраннинга: модули прото-кинетического ускорителя
    .desc = { ent-BitrunningGearSimpleDisk.desc }
ent-BitrunningGearPremiumPKAModsDisk = снаряжение битраннинга: премиум-модули прото-кинетического ускорителя
    .desc = { ent-BitrunningGearSimpleDisk.desc }
ent-BitrunningGearCrusherModsDisk = снаряжение битраннинга: модули прото-кинетического дробителя
    .desc = { ent-BitrunningGearSimpleDisk.desc }
ent-BitrunningGearPremiumCrusherModsDisk = снаряжение битраннинга: премиум-модули прото-кинетического дробителя
    .desc = { ent-BitrunningGearSimpleDisk.desc }

# Действия
ent-ActionBitrunningDisconnectAvatar = отключить аватара
    .desc = Вернуться в своё тело и завершить текущую сессию аватара.
ent-ActionBitrunningProgramBasicCheese = призвать сыр
    .desc = Создаёт головки сыра в области 3х3 вокруг вас.
ent-ActionBitrunningProgramBasicLesserHeal = малое исцеление
    .desc = Лечит незначительные ударные и ожоговые повреждения.
ent-ActionBitrunningProgramEliteDragon = превращение в дракона
    .desc = Временно превращает вас в аватара-дракона.
ent-ActionBitrunningProgramEliteBear = превращение в медведя
    .desc = Временно превращает вас в аватара-медведя.

# Статус-эффекты
ent-StatusEffectBitrunningExitBlindness = нейро-слепота

# 🌇Sunset🌇 - роль битраннера
ent-BitrunnerPDA = КПК битраннера
    .desc = Пахнет энергетиками и тёплыми серверными стойками.
ent-BitrunnerIDCard = ID карта битраннера
    .desc = Карта, необходимая для доступа в различные зоны на станции.
ent-SpawnPointBitrunner = точка появления битраннера
    .desc = { "" }

ent-BitrunAvatarIDCard = ID карта аватара битрана
    .desc = Карта, необходимая для доступа в различные зоны на станции.
