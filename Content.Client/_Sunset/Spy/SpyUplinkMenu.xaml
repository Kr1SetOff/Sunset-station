<controls:SpyUplinkMenu
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._Sunset.Spy"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    Title="{Loc 'spy-uplink-ui-title'}"
    MinSize="480 520"
    SetSize="480 520">
    <PanelContainer>
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#0B0B0DFF" />
        </PanelContainer.PanelOverride>
        <BoxContainer Orientation="Vertical">
            <BoxContainer Orientation="Horizontal" Margin="4,4,4,0">
                <Button Name="MarketTabButton" Access="Public" Text="{Loc 'spy-uplink-ui-market'}"
                        HorizontalExpand="True" StyleClasses="OpenBoth" />
                <Button Name="ContractsTabButton" Access="Public" Text="{Loc 'spy-uplink-ui-contracts'}"
                        HorizontalExpand="True" StyleClasses="OpenBoth" />
            </BoxContainer>

            <PanelContainer Margin="4,4,4,4">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#1A0000FF" />
                </PanelContainer.PanelOverride>
                <RichTextLabel Name="BalanceInfo" Access="Public" Margin="6,4,6,4" />
            </PanelContainer>

            <BoxContainer Name="MarketTab" Access="Public" Orientation="Vertical" VerticalExpand="True">
                <BoxContainer Name="CategoryButtonsContainer" Access="Public" Orientation="Horizontal"
                              Margin="4,0,4,4" HorizontalExpand="True" />
                <BoxContainer Orientation="Horizontal" Margin="4,0,4,4">
                    <Button Name="WithdrawButton" Access="Public" Text="{Loc 'store-ui-default-withdraw-text'}"
                            HorizontalAlignment="Right" MinWidth="64" />
                </BoxContainer>
                <PanelContainer VerticalExpand="True">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#000000FF" />
                    </PanelContainer.PanelOverride>
                    <ScrollContainer HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True">
                        <BoxContainer Name="MarketListingsContainer" Access="Public" Orientation="Vertical"
                                      HorizontalExpand="True" />
                    </ScrollContainer>
                </PanelContainer>
            </BoxContainer>

            <BoxContainer Name="ContractsTab" Access="Public" Orientation="Vertical" VerticalExpand="True"
                          Visible="False">
                <BoxContainer Orientation="Horizontal" Margin="4,0,4,4">
                    <RichTextLabel Name="ReputationLabel" Access="Public" HorizontalExpand="True" />
                    <RichTextLabel Name="RotationLabel" Access="Public" />
                </BoxContainer>

                <BoxContainer Name="ActiveContractSection" Access="Public" Orientation="Vertical" Visible="False">
                    <PanelContainer Margin="4,0,4,4">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#1A0000FF" BorderColor="#CC2936FF" BorderThickness="1" />
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical" Margin="8,6,8,6">
                            <RichTextLabel Name="ActiveContractLabel" Access="Public" />
                            <ProgressBar Name="ActiveContractProgress" Access="Public" MinValue="0" MaxValue="1"
                                         MinHeight="14" Margin="0,4,0,4">
                                <ProgressBar.BackgroundStyleBoxOverride>
                                    <gfx:StyleBoxFlat BackgroundColor="#2A0000FF" />
                                </ProgressBar.BackgroundStyleBoxOverride>
                                <ProgressBar.ForegroundStyleBoxOverride>
                                    <gfx:StyleBoxFlat BackgroundColor="#CC2936FF" />
                                </ProgressBar.ForegroundStyleBoxOverride>
                            </ProgressBar>
                            <Button Name="AbandonButton" Access="Public" Text="{Loc 'spy-uplink-ui-contract-abandon'}"
                                    HorizontalAlignment="Right" />
                        </BoxContainer>
                    </PanelContainer>
                </BoxContainer>

                <PanelContainer VerticalExpand="True">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#000000FF" />
                    </PanelContainer.PanelOverride>
                    <ScrollContainer HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True">
                        <BoxContainer Name="ContractsContainer" Access="Public" Orientation="Vertical"
                                      HorizontalExpand="True" />
                    </ScrollContainer>
                </PanelContainer>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</controls:SpyUplinkMenu>
